<UserControl x:Class="RockBoxPlaylistTool.Music.MusicUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RockBoxPlaylistTool"
             xmlns:localData="clr-namespace:RockBoxPlaylistTool.Data"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="MusicGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="75"/>
        </Grid.ColumnDefinitions>

        <TextBlock 
            x:Name="txtMusicPath" 
            Grid.Row="0" 
            Grid.Column="0" 
            Margin="5" 
            Text="{Binding Path}" 
            FontSize="28" 
            Background="White"/>
        <Button 
            x:Name="btnBrowseMusic" 
            Grid.Column="1" 
            Margin="5" 
            Command="{Binding BrowseCommand}">
            <Image Source="/images/browse.png"/>
        </Button>

        <AdornerDecorator Grid.Row="1" 
                          Grid.Column="0">
            <TextBox 
                x:Name="txtSearch" 
                Width="{Binding ActualWidth, ElementName=txtMusicPath}" 
                Margin="5" 
                Text="{Binding SearchQuery,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                FontSize="20">
              <localData:WatermarkService.Watermark>
                    <TextBlock>Search...</TextBlock>
              </localData:WatermarkService.Watermark>
            </TextBox>
        </AdornerDecorator>
        <Image
            Source="/images/search.png" 
            Grid.Row="1" 
            Grid.Column="1" 
            Margin="5"/>

        <ListBox 
            ItemsSource="{Binding ItemsView}" 
            SelectedItem="{Binding Selected}" 
            SelectionMode="Extended" 
            Grid.Row="2" 
            Grid.ColumnSpan="2"> 
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
